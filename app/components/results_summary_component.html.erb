<div class="alert alert-secondary alert-dismissible shadow-sm results-summary" role="status">
  <div class="d-flex align-items-center flex-wrap mb-2">
    <strong class="me-2">✦ About these results</strong>
    <span class="badge bg-warning text-dark me-2">Beta</span>
    <small class="text-muted me-4">AI-generated from finding-aid descriptions</small>
    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>

  <p class="mb-2"><%= summary_html %></p>

  <% if related_topics.any? %>
    <div class="mt-2">
      <strong class="d-block mb-1 small text-uppercase text-muted">✦ Search related topics</strong>
      <% related_topics.each do |term| %>
        <%= link_to related_topic_href(term), class: 'btn btn-outline-secondary btn-sm rounded-pill me-1 mb-1',
                                               data: { turbo_frame: '_top' } do %>
          <%= term %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
