<%# locals: (url:, placeholder:, disabled: false, button_label: t('ai_summary.send_label')) %>
<%= form_with url: url, method: :get, local: true, class: 'ask-ai-input-bar input-group' do |f| %>
  <span class="input-group-text ask-ai-input-bar__icon" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
      <path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z" />
    </svg>
  </span>
  <%= f.search_field :q,
        class: 'form-control',
        placeholder: placeholder,
        aria: { label: placeholder },
        autocomplete: 'off' %>
  <%= tag.button button_label,
        class: 'btn btn-outline-primary',
        type: disabled ? 'button' : 'submit' %>
<% end %>
